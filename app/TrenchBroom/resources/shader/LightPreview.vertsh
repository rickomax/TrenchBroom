/*
 The preview covers the whole view, so its corners are given in clip space directly and
 neither the projection nor the model view matrix is applied to them.
 */
void main(void)
{
  gl_Position = vec4(gl_Vertex.xy, 0.0, 1.0);
  gl_TexCoord[0] = gl_MultiTexCoord0;
}
