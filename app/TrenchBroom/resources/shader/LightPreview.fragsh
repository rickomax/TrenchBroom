uniform sampler2D Image;

/*
 The preview fades in over its first few passes, so that it does not appear at full
 strength while it is still at its noisiest.
 */
uniform float Alpha;

void main()
{
  gl_FragColor = vec4(texture2D(Image, gl_TexCoord[0].st).rgb, Alpha);
}
